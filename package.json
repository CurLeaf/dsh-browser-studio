{
  "name": "dsh-browser-studio",
  "version": "0.1.0",
  "description": "Browser studio for DeepSeek Harness: Chrome-style device toolbar and Cursor-style element picking inside the built-in browser, one click into the session.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build-agent.mjs && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "test:agent": "node scripts/build-agent.mjs && npm run build:fixture && node test/agent.e2e.mjs && node test/react-agent.e2e.mjs",
    "test:bundle": "node scripts/build-client.mjs && node test/bundle.e2e.mjs",
    "test:all": "npm run build && npm run typecheck && vitest run && npm run test:bundle && npm run test:agent",
    "build:fixture": "esbuild test/fixture/react-app.tsx --bundle --format=iife --platform=browser --jsx=automatic --define:process.env.NODE_ENV='\"development\"' --outfile=test/fixture/react-app.js --log-level=error",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curleaf/dsh-browser-studio.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "device",
    "responsive",
    "annotate"
  ],
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "bippy": "^0.7.3",
    "electron": "44.7.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.64.1",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
